<Window x:Class="PreciousMetalsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PreciousMetalsManager"
        xmlns:models="clr-namespace:PreciousMetalsManager.Models"
        mc:Ignorable="d"
        Title="{DynamicResource MainWindow_Title}" Height="450" Width="1000">

    <Window.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <models:CollectableTypeToLabelConverter x:Key="CollectableTypeToLabelConverter"/>
        <models:MetalTypeToLabelConverter x:Key="MetalTypeToLabelConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
            <RowDefinition Height="Auto"/>  <!-- Current Market Price of Metals -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10">
            
            <Border Margin="0,0,50,0" Padding="4" Background="#FFF8F8F8" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource AddButton}"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding AddHoldingCommand}"/>

                    <Button Content="{DynamicResource EditButton}"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding EditHoldingCommand}"/>

                    <Button Content="{DynamicResource DeleteButton}"
                            Width="80"
                            Command="{Binding DeleteSelectedHoldingsCommand}"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,50,0" Padding="4" Background="#FFF8F8F8" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource EditPricesButton}"
                            Width="100"
                            Margin="0,0,5,0"
                            Command="{Binding EditPricesCommand}"/>

                    <Button Content="{DynamicResource RefreshPricesButton}" Width="120" Command="{Binding RefreshPricesCommand}"/>
                </StackPanel>
            </Border>

            <Border Padding="4" Background="#FFF8F8F8" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource ExportButton}" Width="80" Margin="0,0,5,0" Click="ExportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource ExportDialog_Simple}" Command="{Binding ExportSimpleCommand}" />
                                <MenuItem Header="{DynamicResource ExportDialog_Detailed}" Command="{Binding ExportDetailedCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{DynamicResource ImportButton}" Width="80" Command="{Binding ImportCommand}" />
                </StackPanel>
            </Border>
            
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <Label Content="{DynamicResource Lbl_Gold}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding GoldPriceDisplay}" Width="80" Margin="2,0" VerticalAlignment="Center"/>
            <Label Content="{DynamicResource Lbl_Silver}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SilverPriceDisplay}" Width="80" Margin="2,0" VerticalAlignment="Center"/>
            <Label Content="{DynamicResource Lbl_Platinum}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PlatinumPriceDisplay}" Width="80" Margin="2,0" VerticalAlignment="Center"/>
            <Label Content="{DynamicResource Lbl_Palladium}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PalladiumPriceDisplay}" Width="80" Margin="2,0" VerticalAlignment="Center"/>
            <Label Content="{DynamicResource Lbl_Bronce}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BroncePriceDisplay}" Width="80" Margin="2,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Label Content="{DynamicResource Lbl_MetalTypeFilter}" VerticalAlignment="Center"/>
                <ComboBox x:Name="MetalTypeFilterComboBox"
                          Width="120"
                          Margin="5,0"
                          ItemsSource="{Binding MetalTypeFilterOptions}"
                          SelectedItem="{Binding SelectedMetalTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource MetalTypeToLabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Label Content="{DynamicResource Lbl_FormVariantFilter}" VerticalAlignment="Center"/>
                <TextBox x:Name="FormFilterTextBox"
                         Width="120"
                         Margin="5,0"
                         Text="{Binding FormFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="{DynamicResource Common_CollectableType}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ClassificationFilterComboBox"
                          Width="150"
                          Margin="5,0"
                          ItemsSource="{Binding CollectableTypeFilterOptions}"
                          SelectedItem="{Binding SelectedCollectableTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource CollectableTypeToLabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Content="{DynamicResource TaxFreeOnly_Checkbox}" 
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding TaxFreeOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Label Content="{DynamicResource Lbl_TotalValueDisplayed}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VisibleHoldingsTotalValue, StringFormat=F2}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Label Content="{Binding CurrencyUnitSimplyfied}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <DataGrid x:Name="MainDataGrid"
                      ItemsSource="{Binding FilteredHoldings}"
                      SelectedItem="{Binding SelectedHolding, Mode=TwoWay}"
                      SelectionChanged="MainDataGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AlternationCount="2">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FFF0F0F0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding MetalType, Converter={StaticResource MetalTypeToLabelConverter}}" Width="Auto">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common_MetalType}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Form}" Width="*">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common_Form}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CollectableType, Converter={StaticResource CollectableTypeToLabelConverter}}" Width="Auto">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common_CollectableType}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Purity, StringFormat=F1}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock>
                                <Run Text="{DynamicResource Common_Purity}" />
                                <Run Text="{Binding DataContext.PurityUnit, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Weight, StringFormat=F1}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock>
                                <Run Text="{DynamicResource Common_Weight}" />
                                <Run Text="{Binding DataContext.WeightUnit, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Quantity}" Width="Auto">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common_Quantity}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding PurchasePrice, StringFormat=F2}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock>
                                <Run Text="{DynamicResource Common_PurchasePrice}" />
                                <Run Text="{Binding DataContext.CurrencyUnit, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding PurchaseDate, StringFormat='dd.MM.yyyy'}" Width="Auto">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Common_PurchaseDate}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding TaxFreeStatus}" IsReadOnly="True" SortMemberPath="TaxFreeSortValue" Width="Auto">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource Col_TaxFreeStatus}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CurrentValue, StringFormat=F2}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock>
                                <Run Text="{DynamicResource Col_CurrentValue}" />
                                <Run Text="{Binding DataContext.CurrencyUnit, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding TotalValue, StringFormat=F2}" Width="Auto">
                        <DataGridTextColumn.Header>
                            <TextBlock>
                                <Run Text="{DynamicResource Col_TotalValue}" />
                                <Run Text="{Binding DataContext.CurrencyUnit, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            </TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock
                Text="{DynamicResource Txt_NoHoldingsMatch}"
                Foreground="Gray"
                FontStyle="Italic"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding FilteredHoldings.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                IsHitTestVisible="False"
                FontSize="16"
                Padding="20"/>
        </Grid>

        <Button x:Name="LanguageButton"
                Content="{DynamicResource LanguageButtonShort}"
                Height="20"
                VerticalAlignment="Top"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Width="30"
                Command="{Binding ToggleLanguageCommand}"/>
    </Grid>

</Window>
