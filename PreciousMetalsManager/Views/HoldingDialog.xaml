<Window x:Class="PreciousMetalsManager.Views.HoldingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PreciousMetalsManager.Views"
        mc:Ignorable="d"
        Title="{DynamicResource HoldingDialog_Title}" Height="485" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Label Content="{DynamicResource Common_MetalType}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <ComboBox Name="MetalTypeComboBox"
                      Width="130"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource MetalTypeToLabelConverter}}" TextAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="{DynamicResource HoldingDialog_Lbl_FormVariant}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBox Name="FormTextBox" Width="130" HorizontalAlignment="Center"/>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_Purity}" />
                    <TextBlock Text="{Binding PurityUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <ComboBox Name="PurityComboBox"
                      IsEditable="True"
                      Text="999,9"
                      Width="130"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      Margin="0,0,0,10"
                      PreviewTextInput="PurityComboBox_PreviewTextInput"
                      LostFocus="PurityComboBox_LostFocus"
                      ItemsSource="{Binding CommonPurities}">
            </ComboBox>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_Weight}" />
                    <TextBlock Text="{Binding WeightUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <TextBox Name="WeightTextBox"
                     Text="1.00"
                     Width="130"
                     HorizontalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="WeightTextBox_PreviewTextInput"
                     LostFocus="WeightTextBox_LostFocus"/>

            <Label Content="{DynamicResource Common_Quantity}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="▲" Width="25" Click="IncreaseQuantity_Click"/>
                <TextBox Name="QuantityTextBox"
                         Text="1"
                         Width="80"
                         HorizontalContentAlignment="Center"
                         HorizontalAlignment="Center"
                         PreviewTextInput="QuantityTextBox_PreviewTextInput"
                         LostFocus="QuantityTextBox_LostFocus"/>
                <Button Content="▼" Width="25" Click="DecreaseQuantity_Click"/>
            </StackPanel>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_PurchasePrice}" />
                    <TextBlock Text="{Binding CurrencyUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <TextBox Name="PurchasePriceTextBox"
                     Text="0.00"
                     Width="130"
                     HorizontalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="PurchasePriceTextBox_PreviewTextInput"
                     LostFocus="PurchasePriceTextBox_LostFocus"/>

            <Label Content="{DynamicResource Common_PurchaseDate}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <DatePicker Name="PurchaseDatePicker"
                        Width="130"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"/>

            <Label Content="{DynamicResource Common_CollectableType}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Name="CollectableType_BullionRadioButton"
                             Content="{DynamicResource CollectableType_Bullion}"
                             IsChecked="{Binding SelectedCollectableType, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Bullion, Mode=TwoWay}"
                             GroupName="CollectableType"
                             Margin="0,0,20,0"/>
                <RadioButton Name="CollectableType_SemiNumismaticRadioButton"
                             Content="{DynamicResource CollectableType_SemiNumismatic}"
                             IsChecked="{Binding SelectedCollectableType, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SemiNumismatic, Mode=TwoWay}"
                             GroupName="CollectableType"
                             Margin="0,0,20,0"/>
                <RadioButton Name="CollectableType_NumismaticRadioButton"
                             Content="{DynamicResource CollectableType_Numismatic}"
                             IsChecked="{Binding SelectedCollectableType, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Numismatic, Mode=TwoWay}"
                             GroupName="CollectableType"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Name="SaveButton" Content="{DynamicResource HoldingDialog_Btn_Save}" Width="80" Margin="5" Click="SaveButton_Click"/>
            <Button Name="CancelButton" Content="{DynamicResource HoldingDialog_Btn_Cancel}" Width="80" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
