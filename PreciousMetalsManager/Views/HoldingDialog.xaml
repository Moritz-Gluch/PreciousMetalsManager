<Window x:Class="PreciousMetalsManager.Views.HoldingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:models="clr-namespace:PreciousMetalsManager.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{DynamicResource HoldingDialog_Title}" Height="485" Width="350">
    <Window.Resources>
        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <ObjectDataProvider x:Key="MetalTypesProvider"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MetalType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Label Content="{DynamicResource Common_MetalType}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <ComboBox Name="MetalTypeComboBox"
                      Width="130"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      ItemsSource="{Binding Source={StaticResource MetalTypesProvider}}"
                      SelectedItem="{Binding SelectedMetalType, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource MetalTypeToLabelConverter}}" TextAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="{DynamicResource HoldingDialog_Lbl_FormVariant}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBox Name="FormTextBox"
                     Width="130"
                     HorizontalAlignment="Center"
                     Text="{Binding FormText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="FormTextBox_LostFocus"/>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_Purity}" />
                    <TextBlock Text="{Binding PurityUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <ComboBox Name="PurityComboBox"
                      IsEditable="True"
                      Width="130"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      Margin="0,0,0,10"
                      PreviewTextInput="PurityComboBox_PreviewTextInput"
                      LostFocus="PurityComboBox_LostFocus"
                      ItemsSource="{Binding CommonPurities}"
                      Text="{Binding PurityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </ComboBox>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_Weight}" />
                    <TextBlock Text="{Binding WeightUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <TextBox Name="WeightTextBox"
                     Width="130"
                     HorizontalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Text="{Binding WeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="WeightTextBox_PreviewTextInput"
                     LostFocus="WeightTextBox_LostFocus"/>

            <Label Content="{DynamicResource Common_Quantity}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="▲" Width="25" Command="{Binding IncreaseQuantityCommand}"/>
                <TextBox Name="QuantityTextBox"
                         Width="80"
                         HorizontalContentAlignment="Center"
                         HorizontalAlignment="Center"
                         Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="QuantityTextBox_PreviewTextInput"
                         LostFocus="QuantityTextBox_LostFocus"/>
                <Button Content="▼" Width="25" Command="{Binding DecreaseQuantityCommand}"/>
            </StackPanel>

            <Label HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Common_PurchasePrice}" />
                    <TextBlock Text="{Binding CurrencyUnit}" Margin="6,0,0,0" />
                </StackPanel>
            </Label>
            <TextBox Name="PurchasePriceTextBox"
                     Width="130"
                     HorizontalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Text="{Binding PurchasePriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="PurchasePriceTextBox_PreviewTextInput"
                     LostFocus="PurchasePriceTextBox_LostFocus"/>

            <Label Content="{DynamicResource Common_PurchaseDate}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <DatePicker Name="PurchaseDatePicker"
                        Width="130"
                        HorizontalAlignment="Center"
                        SelectedDate="{Binding PurchaseDate, Mode=TwoWay}"
                        LostFocus="PurchaseDatePicker_LostFocus"/>

            <Label Content="{DynamicResource Common_CollectableType}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Name="CollectableType_BullionRadioButton"
                             Content="{DynamicResource CollectableType_Bullion}"
                             IsChecked="{Binding SelectedCollectableType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Bullion, Mode=TwoWay}"
                             GroupName="CollectableType"
                             Margin="0,0,20,0"/>
                <RadioButton Name="CollectableType_SemiNumismaticRadioButton"
                             Content="{DynamicResource CollectableType_SemiNumismatic}"
                             IsChecked="{Binding SelectedCollectableType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SemiNumismatic, Mode=TwoWay}"
                             GroupName="CollectableType"
                             Margin="0,0,20,0"/>
                <RadioButton Name="CollectableType_NumismaticRadioButton"
                             Content="{DynamicResource CollectableType_Numismatic}"
                             IsChecked="{Binding SelectedCollectableType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Numismatic, Mode=TwoWay}"
                             GroupName="CollectableType"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Name="SaveButton" Width="80" Margin="5" Command="{Binding SaveCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="{DynamicResource Common_Add}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Content" Value="{DynamicResource Common_Save}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="AddAnotherButton"
                    Content="{DynamicResource HoldingDialog_Btn_AddAnother}"
                    Width="120"
                    Margin="5"
                    Command="{Binding AddAnotherCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="CancelButton"
                    Content="{DynamicResource Common_Cancel}"
                    Width="80"
                    Margin="5"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
